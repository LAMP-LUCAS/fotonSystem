{
  "$schema": "https://opencode.ai/schema.json",
  "experimental": {
    "cacheStabilization": true,
    "compactMaxTokens": 8000
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**", "**/dist/**", "**/build/**",
      "**/coverage/**", "**/.git/**", "**/*.log",
      "**/.env", "**/__pycache__/**", "**/target/**",
      "**/.pytest_cache/**", "**/*.bak", "**/GERADO_*"
    ]
  },
  "models": {
    "fast": "deepseek/deepseek-chat",
    "smart": "deepseek/deepseek-v4-flash",
    "reasoning": "anthropic/claude-3.5-sonnet"
  },
  "agentDefaults": {
    "maxTurns": 15,
    "model": "smart"
  },
  "plugins": ["opencode-cachebro", "opencode-agent-optimizer"]
}
